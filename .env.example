# Core search params
# You can specify multiple origins/destinations separated by pipes (|)
# Examples:
#   ORIGIN=PRG              (single origin)
#   ORIGIN=PRG|VIE|BRQ      (multiple origins: Prague, Vienna, Brno)
#   DESTINATION=SGN|HAN     (multiple destinations: Saigon, Hanoi)
ORIGIN=PRG
DESTINATION=SGN
DEPARTURE_DATE=2026-08-01
ARRIVAL_DATE=2026-08-15
ADULTS=2

# Runtime
REFRESH_INTERVAL_DAYTIME_MINUTES=30
REFRESH_INTERVAL_NIGHTTIME_MINUTES=120
USER_AGENT=Mozilla/5.0 (compatible; VietnamTicketsScraper/1.0)
HEADLESS=true

# Output
DATA_DIR=./data
SEEN_FILE=./data/seen_offers.txt

# API Keys (for API-based providers)
# Get your API key from https://rapidapi.com/skyscanner/api/skyscanner-api
# Free tier: 100 calls/month
SKYSCANNER_API_KEY=your_api_key_here

# Discord notifications (optional)
# Get webhook URL from Discord: Server Settings > Integrations > Webhooks > New Webhook
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN

# Provider specific (examples)
# VIETNAM_AIRLINES_LOCALE=en-US
# BAMBOO_COOKIE=foo=bar; session=...
